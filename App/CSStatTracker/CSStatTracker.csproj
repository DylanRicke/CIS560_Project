<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CSStatTracker</RootNamespace>
    <UserSecretsId>eec45927-ad67-46ad-874f-941f3d7d6e83</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADO.NET driver for SQL Server. No ORM is used: every query is a
         stored procedure called through SqlCommand / SqlDataReader. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
