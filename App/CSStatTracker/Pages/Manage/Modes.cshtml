@page
@model CSStatTracker.Pages.Manage.ModesModel
@{
    ViewData["Title"] = "Game modes";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Manage</p>
        <h1>Game modes</h1>
        <p class="sub">Team size sets how many player rows the import form shows. Max rounds is the regulation limit; a score can't go above it. A change that would break matches already recorded in a mode is refused.</p>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="error-box" role="alert"><strong>That didn't save.</strong> @Model.Error</div>
}

<form method="post" asp-page-handler="Add" class="filters" aria-label="Add a game mode">
    <label>New mode name
        <input name="modeName" maxlength="20" required placeholder="e.g. Retakes" />
    </label>
    <label>Players per team
        <input type="number" name="playersPerTeam" min="1" max="10" required value="5" />
    </label>
    <label>Max rounds
        <input type="number" name="maxRounds" min="1" max="60" required value="24" />
    </label>
    <div class="actions"><button class="btn btn-primary" type="submit">Add mode</button></div>
</form>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr>
                <th>Name</th>
                <th class="num">Players per team</th>
                <th class="num">Max rounds</th>
                <th class="num">Matches</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Modes)
            {
                var formId = $"mode-{m.GameModeId}";
                <tr>
                    <td><input form="@formId" name="modeName" value="@m.ModeName" maxlength="20" required aria-label="Name for @m.ModeName" /></td>
                    <td class="num"><input form="@formId" type="number" name="playersPerTeam" value="@m.PlayersPerTeam" min="1" max="10" required aria-label="Players per team for @m.ModeName" /></td>
                    <td class="num"><input form="@formId" type="number" name="maxRounds" value="@m.MaxRounds" min="1" max="60" required aria-label="Max rounds for @m.ModeName" /></td>
                    <td class="num">@Fmt.Int(m.MatchCount)</td>
                    <td>
                        <form id="@formId" method="post" asp-page-handler="Update">
                            <input type="hidden" name="gameModeId" value="@m.GameModeId" />
                            <button class="btn btn-small" type="submit">Save</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
