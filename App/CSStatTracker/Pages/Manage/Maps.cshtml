@page
@model CSStatTracker.Pages.Manage.MapsModel
@{
    ViewData["Title"] = "Maps";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Manage</p>
        <h1>Maps</h1>
        <p class="sub">Every map a match can be imported on. Renaming a map renames it on every match already recorded.</p>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="error-box" role="alert"><strong>That didn't save.</strong> @Model.Error</div>
}

<form method="post" asp-page-handler="Add" class="filters" aria-label="Add a map">
    <label>New map name
        <input name="mapName" maxlength="32" required placeholder="e.g. Basalt" />
    </label>
    <label>Type
        <select name="mapType">
            @foreach (var t in MapTypes.All)
            {
                <option value="@t">@t</option>
            }
        </select>
    </label>
    <div class="actions"><button class="btn btn-primary" type="submit">Add map</button></div>
</form>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th class="num">Matches</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Maps)
            {
                var formId = $"map-{m.MapId}";
                <tr>
                    <td><input form="@formId" name="mapName" value="@m.MapName" maxlength="32" required aria-label="Name for @m.MapName" /></td>
                    <td>
                        <select form="@formId" name="mapType" aria-label="Type for @m.MapName">
                            @foreach (var t in MapTypes.All)
                            {
                                <option value="@t" selected="@(t == m.MapType)">@t</option>
                            }
                        </select>
                    </td>
                    <td class="num">@Fmt.Int(m.MatchCount)</td>
                    <td>
                        <form id="@formId" method="post" asp-page-handler="Update">
                            <input type="hidden" name="mapId" value="@m.MapId" />
                            <button class="btn btn-small" type="submit">Save</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
